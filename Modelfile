FROM gemma4:latest

# Keep context large enough for a full 42-territory board state
PARAMETER num_ctx 8192

# Low temperature for deterministic, rule-following output
PARAMETER temperature 0.1
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1

# Enough tokens for one JSON object; gemma4 thinking disabled by omitting <|think|>
PARAMETER num_predict 256

# Short system prompt (< 500 chars avoids gemma4:26b MoE crash bug)
# Do NOT include <|think|> token — that is what triggers thinking mode
SYSTEM "You are a Risiko JSON engine. Return exactly one legal action as a JSON object. No markdown, no prose, no code fences.\n\nFormat: {\"action_type\":\"...\",\"param_a\":0,\"param_b\":0,\"param_c\":0,\"param_d\":0,\"reasoning\":\"...\"}\n\nOnly pick from the legal_actions list. Never output anything except valid JSON."
